<% title "Log Book" %>


<%= form_tag("/log_book", method: "get", id: "log_book_form") do %>
    <%= label_tag(:q, "Log Diary:") %>
    <%= text_field_tag :log_field, params[:log_field], placeholder: "Log a message" %>
    <%= submit_tag("Write") %>
    <p>
      <%= log_book_reload -%>
      <% if defined?(@log_book) %>
           <%= @log_book.join('<br />').html_safe %></p>
    <% end %>
<% end %>