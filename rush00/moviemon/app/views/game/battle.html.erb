<div class="game_area-gameview-screen" id="battle_screen">

  <img src="<%= Dictionary_Movie()['Poster']%>" width="60"/><span class="read_text">Rating :
  <%= Dictionary_Movie()['imdbRating']%>    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
		&nbsp; &nbsp;    HP: <%= HP_Monster() %>  </span>
  <br/>
  <b><u><span class="read_text"><%= Dictionary_Movie()['Title']%>,</span></b></u><br/>
  <span class="read_text"><%= Dictionary_Movie()['Plot']%></span>
  <% if battle_commentary.length > 0 %>
      <div class="message"> <span class="read_text"><%= battle_commentary%></span></div>
  <% end %>
  <div class="moviballs"> HP : <%= HP_Player() %></div>
</div>