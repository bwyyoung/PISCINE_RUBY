<div class="game_area-gameview-screen" id="options">
  <center><span class="read_text">LOAD GAME</span>
    <br /><br />
    <span class="read_text">Select SAVE SLOT to LOAD</span><br />
    <% max_slots.times{|x| %>
        <p class= "<% if x == save_index %>save_selected<% end %>">
          <span class="read_text">
            SAVE SLOT <%=x %>
					</span>
        </p>
    <% } %>
  </center>
</div>